# App Name
NUXT_APP_NAME=LokalBoards
NUXT_BOARDS_URL=http://localhost:3000
NUXT_LANGUAGE=en
NUXT_PUBLIC_PRIVACY_URL=https://www.yourdomain.com/privacy-policy/
NUXT_MCP=true
NUXT_PUBLIC_SIGNUP=true
# Log verbosity: debug | info | warn | error (default: info)
NUXT_LOG_LEVEL=info
# How many days a login session stays valid (default: 1)
NUXT_SESSION_MAX_AGE_DAYS=1
# Which client address the sign-in and password-reset limits count by.
# Empty or auto: X-Forwarded-For is believed (one proxy, read from the right)
# only when the connection comes from loopback or a private network — a reverse
# proxy on the same host or Docker network. true: always one proxy. A number:
# that many proxies in a chain (e.g. 2 for Cloudflare in front of nginx).
# false: never; use it when nothing sits in front of the app.
NUXT_TRUST_PROXY=

# The first administrator, created at startup when the instance has none.
# Only read while no administrator exists, so it is safe to leave set — and it
# restores access if the last admin is ever deleted. Never overwrites the
# password of an account that already exists.
NUXT_ADMIN_EMAIL=
NUXT_ADMIN_PASSWORD=
NUXT_ADMIN_NAME=Administrator

# DB
NUXT_MYSQL_HOST=localhost
# Only if the database is not on MySQL's usual port (3306).
NUXT_MYSQL_PORT=
NUXT_MYSQL_USER=root
NUXT_MYSQL_PASSWORD=root1234
NUXT_MYSQL_DATABASE=root
# Set to true if your database server requires a TLS/SSL connection
# (e.g. managed/external MySQL). Leave false for a local DB without SSL.
NUXT_MYSQL_SSL=false
# Only set to false if the server's certificate can't be verified against a
# public CA (less secure). Defaults to true (verify the certificate).
NUXT_MYSQL_SSL_REJECT_UNAUTHORIZED=true

# Email Configuration
NUXT_EMAIL_HOST=mail.yourserver.de
NUXT_EMAIL_PORT=465
NUXT_EMAIL_SECURE=true
NUXT_EMAIL_USER=contact@yourdomain.com
NUXT_EMAIL_PASS=password1234
